{
  // Site da Orbyt Studio (orbytstudio.com.br). O nome tem de ser igual ao do projeto na Cloudflare.
  "name": "orbyt-studio",
  "compatibility_date": "2026-11-01",
  // Servidor: responde só em /api/... (pagamento Mercado Pago e entrega do PDF). O resto sai de public/.
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Os 40 prompts mudaram para krenakcursos.com.br (26/11/2026): essas páginas passam pelo servidor, que redireciona.
    "run_worker_first": ["/40prompts-estudante-medicina", "/40prompts-estudante-medicina/*"]
  },
  // O PDF vai criptografado dentro do servidor. Sem a chave PDF_KEY ninguém abre.
  "rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": false }],
  // Mantém as variáveis e segredos criados no painel da Cloudflare a cada deploy.
  // Guarda o e-mail de cada comprador para o envio do PDF depois que o pagamento confirma.
  "kv_namespaces": [{ "binding": "PEDIDOS", "id": "41ab98434fc948beb4385aa1ec5cd36d" }],
  // Banco SQL (D1) com as sessões do funil do checkout. Sem "database_id" de propósito:
  // o wrangler cria o banco "orbyt-funil" no primeiro deploy e mantém a ligação nos seguintes.
  "d1_databases": [{ "binding": "FUNIL", "database_name": "orbyt-funil" }],
  // Sem cron desde 26/11/2026: os e-mails de recuperação e pós-compra saem do servidor da Krenak Cursos (mesmo banco).
  "triggers": { "crons": [] },
  "keep_vars": true,
  "observability": { "enabled": true }
}
