{
  // Site da Orbyt Studio (orbytstudio.com.br). O nome tem de ser igual ao do projeto na Cloudflare.
  "name": "orbyt-studio",
  "compatibility_date": "2026-11-01",
  // Servidor: responde só em /api/... (pagamento Mercado Pago e entrega do PDF). O resto sai de public/.
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // O PDF vai criptografado dentro do servidor. Sem a chave PDF_KEY ninguém abre.
  "rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": false }],
  // Mantém as variáveis e segredos criados no painel da Cloudflare a cada deploy.
  "keep_vars": true,
  "observability": { "enabled": true }
}
